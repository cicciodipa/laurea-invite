<script>
  // Show/hide extra fields based on presence selection
  document.querySelectorAll('input[name="presenza"]').forEach(radio => {
    radio.addEventListener('change', function() {
      const extra = document.getElementById('extra-fields');
      extra.style.display = this.value === 'si' ? 'block' : 'none';
      extra.style.animation = 'fadeIn 0.4s ease';
    });
  });

  async function inviaRSVP() {
    const nome = document.getElementById('nome').value.trim();
    const presenza = document.querySelector('input[name="presenza"]:checked');

    if (!nome) {
      alert('Per favore inserisci il tuo nome.');
      return;
    }
    if (!presenza) {
      alert('Per favore indica se parteciperai.');
      return;
    }

    const btn = document.querySelector('.btn-submit');
    btn.textContent = 'Invio in corso...';
    btn.disabled = true;

    const data = {
      nome: nome,
      presenza: presenza.value,
      festeggiamento: document.getElementById('festeggiamento')?.value || '—',
      adulti: document.getElementById('adulti')?.value || '—',
      bambini: document.getElementById('bambini')?.value || '—',
      note: document.getElementById('note')?.value || '—'
    };

    try {
      const response = await fetch('https://formspree.io/f/xrejoedj', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify(data)
      });

      if (response.ok) {
        document.getElementById('rsvp-form').style.display = 'none';
        const success = document.getElementById('success');
        success.style.display = 'block';
      } else {
        alert('Qualcosa è andato storto. Riprova!');
        btn.textContent = 'Invia la tua risposta';
        btn.disabled = false;
      }
    } catch (e) {
      alert('Errore di connessione. Riprova!');
      btn.textContent = 'Invia la tua risposta';
      btn.disabled = false;
    }
  }
</script>

